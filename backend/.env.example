APP_NAME=Varanda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Endereço do front-end Next.js (CORS e link de redefinição de senha)
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=varanda
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Em desenvolvimento, os e-mails (como o de redefinição de senha) vão para storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@varanda.test"
MAIL_FROM_NAME="${APP_NAME}"
